Include ~/.colima/ssh_config

# ===========================================================================
# SSH Config
# Symlinked to ~/.ssh/config by setup.sh
# ===========================================================================

# Defaults for all hosts
Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_rsa
    ServerAliveInterval 60
    ServerAliveCountMax 3
    HashKnownHosts yes
    StrictHostKeyChecking ask
